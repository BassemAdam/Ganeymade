// Declaring entry points by telling compiler compile this function as a GPU entry point
// this allows us to link it to c# scripts and find it in the scripts
#pragma kernel MarchDensity
#pragma kernel ClearArgs


static const int cornerA[12] = {0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3};
static const int cornerB[12] = {1, 2, 3, 0, 5, 6, 7, 4, 4, 5, 6, 7};

struct Vertex
{
    float4 position;
    float4 normal;
};

Texture3D<float2> DensityTexture3D;
SamplerState samplerDensityTexture3D;
Texture3D<float4>  NormalTexture3D;
SamplerState       samplerNormalTexture3D;
StructuredBuffer<int>  lut;
StructuredBuffer<int>  offsets;
StructuredBuffer<int>  lengths;

int3   GridSize;
float3 VoxelSize;
float3 BoundsMinWS;
float  isoLevel;

RWStructuredBuffer<Vertex> vertices;
RWStructuredBuffer<uint> drawArgs;

[numthreads(1,1,1)]
void ClearArgs(uint3 id : SV_DispatchThreadID)
{
    // drawArgs is read by DrawProceduralIndirect to know how to render the mesh
    // It never goes back to the CPU — the GPU reads it directly for rendering

    drawArgs[0] = 0; // vertex count: reset to 0, MarchDensity fills this up via InterlockedAdd
    drawArgs[1] = 1; // instance count: always 1 — we draw the fluid mesh once, not multiple copies
                     // (instancing = draw same mesh N times, e.g. 1000 trees. We dont need that here)
    drawArgs[2] = 0; // start vertex: begin reading vertices from slot 0
    drawArgs[3] = 0; // start instance: begin at instance 0 (irrelevant since instance count = 1)
}

float SampleDensity(int3 pos)
{
    bool isEdge = any(pos <= 0) || any(pos >= GridSize - 1);
    float density = isoLevel;

    if (!isEdge)
    {
        float3 gridSizeSafe = max((float3)GridSize, float3(1.0, 1.0, 1.0));
        float3 uvw = ((float3)pos + 0.5) / gridSizeSafe;
        density = -DensityTexture3D.SampleLevel(samplerDensityTexture3D, uvw, 0).r;
    }

    return density;
}

Vertex MakeVertex(int3 ca, int3 cb)
{
    float3 posA = BoundsMinWS + (float3)ca * VoxelSize;
    float3 posB = BoundsMinWS + (float3)cb * VoxelSize;
    float dA = SampleDensity(ca);
    float dB = SampleDensity(cb);

    float t = (abs(dB - dA) < 0.00001) ? 0.0 : (isoLevel - dA) / (dB - dA);

    float3 vertexPosWS  = posA + t * (posB - posA);
    float3 volumeSizeWS = max((float3)GridSize * VoxelSize, 1e-5);
    float3 uvw          = (vertexPosWS - BoundsMinWS) / volumeSizeWS;
    float3 n    = NormalTexture3D.SampleLevel(samplerNormalTexture3D, uvw, 0).xyz;
    float  nLen = length(n);

    Vertex v;
    v.position = float4(vertexPosWS, 1.0);
    v.normal   = float4((nLen >= 1e-4) ? (n / nLen) : float3(0.0, 0.0, 0.0), 0.0);
    return v;
}

[numthreads(8, 8, 8)]
void MarchDensity(int3 id : SV_DispatchThreadID)
{
    if (id.x >= GridSize.x - 1 || id.y >= GridSize.y - 1 || id.z >= GridSize.z - 1)
        return;

    int3 c[8];
    c[0] = id + int3(0,0,0); c[1] = id + int3(1,0,0);
    c[2] = id + int3(1,0,1); c[3] = id + int3(0,0,1);
    c[4] = id + int3(0,1,0); c[5] = id + int3(1,1,0);
    c[6] = id + int3(1,1,1); c[7] = id + int3(0,1,1);

    int cfg = 0;
    for (int i = 0; i < 8; i++)
        if (SampleDensity(c[i]) < isoLevel)
            cfg |= (1 << i); // shift left by i bits then or it with cfg

    if (cfg == 0 || cfg == 255) return;

    // by using lengths and offsets arrays that i asked llm to generate it for me 
    // LUT is now much more compacted 512 bytes instead of 4kb
    // becase traditional patted format is 256 x 16 every config gets 16 slots event if it only needs 3 or 6 
    // 256 x 16 x 4 bytes (int) = 16,000 bytes 
    // new format : 2460 ints = 9,840 bytes plus 256 x 2 x 4 bytes = 11888 bytes
    int numIdx = lengths[cfg];
    int off    = offsets[cfg];

    uint startIdx;
    // each thread wants to write its traingles somewhere in sahred verticies buffer 
    // atomic add steps
    // 1- first it reads drawArgs[0] which contains number of traingles written so far 
    // 2- it add numIdx to drawArgs[0] to reserve space for its traingles
    // 3- return the old value before the add in startIdx so each thread gets a unique starting index
    InterlockedAdd(drawArgs[0], numIdx, startIdx);

    for (int t = 0; t < numIdx; t += 3)
    {
        int e0 = lut[off + t];
        int e1 = lut[off + t + 1];
        int e2 = lut[off + t + 2];

        vertices[startIdx + t]     = MakeVertex(c[cornerA[e0]], c[cornerB[e0]]);
        vertices[startIdx + t + 1] = MakeVertex(c[cornerA[e1]], c[cornerB[e1]]);
        vertices[startIdx + t + 2] = MakeVertex(c[cornerA[e2]], c[cornerB[e2]]);
        
        // Example to understand the mappinig
        // e0 = 3 which is cornerA = 2, cornerB = 3 which is (1,0,1) and (0,0,1) 
        // after that we give to make vertex (1,0,1) and (0,0,1) to get interpolated vertex positon and normal 
    }
}
