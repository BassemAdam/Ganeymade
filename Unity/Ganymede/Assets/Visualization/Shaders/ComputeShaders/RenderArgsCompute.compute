// Multiplies the triangle count (from CopyCount) by 3 to produce vertex count
// for DrawProceduralIndirect, entirely on the GPU.
#pragma kernel SetRenderArgs

RWStructuredBuffer<uint> RenderArgs;

[numthreads(1,1,1)]
void SetRenderArgs(uint3 id : SV_DispatchThreadID)
{
    // Index count: marching cubes appends triangles, each containing 3 vertices.
    // CopyCount wrote the triangle count into RenderArgs[0].
    // Multiply by 3 to get vertex count for DrawProceduralIndirect.
    RenderArgs[0] *= 3;
    RenderArgs[1] = 1; // Instance count
    RenderArgs[2] = 0; // Start vertex
    RenderArgs[3] = 0; // Start instance
}
