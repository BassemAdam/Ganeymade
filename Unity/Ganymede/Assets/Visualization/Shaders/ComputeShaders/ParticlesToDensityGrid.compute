// Converts SPH particle positions (StructuredBuffer<Particle>) into a 3D dual-phase density grid.
// Liquid and vapour densities are stored in two contiguous slabs of the same RWStructuredBuffer<uint>:
//   Liquid voxel index  = voxelIdx          (slab 0, range [0, N-1])
//   Vapour voxel index  = N + voxelIdx       (slab 1, range [N, 2N-1])
// where N = volX * volY * volZ.
// After splat the buffer is normalised into a RWTexture3D<float2> (R = liquid, G = vapour).
//
// Notes:
// - Uses fixed-point uint accumulation with atomics (InterlockedAdd) for stability.
// - The density texture is trilinear-sampled in the ray-march fragment shader.
//
// Author: Ganymede project

#pragma kernel ClearGrid
#pragma kernel SplatParticles
#pragma kernel NormalizeToTexture
#pragma kernel BlurLiquidDensity
#pragma kernel BlurVapourDensity
#pragma kernel BakeNormals

struct Particle
{
    float3 position;
    float  density;

    float3 velocity;
    float  pressure;

    float3 acceleration;
    float  mass;

    float  temperature;
    int    phase;

    float  _pad0;
    float  _pad1;
};

StructuredBuffer<Particle>  _ParticleBuffer;
// Dual-slab buffer: first N elements = liquid, next N elements = vapour.
// N = _VolumeDims.x * _VolumeDims.y * _VolumeDims.z
RWStructuredBuffer<uint>    _DensityGrid;
RWTexture3D<float2>         _DensityTexture3D_RG;  // R = liquid, G = vapour
// Read-only binding used by BlurVapourDensity to avoid
// reading and writing the same texture in the same dispatch (hazard-free pipeline).
Texture3D<float2>           _DensityTexture3D_Read;
RWTexture3D<float4>         _NormalTexture3D;         // xyz = outward surface normal, w = unused

int3   _VolumeDims;           // xyz
uint   _ParticleCount;
float4 _BoundsMinWS;          // xyz
float4 _BoundsMaxWS;          // xyz
float  _ParticleContribution;  // unitless, per particle
float  _FixedPointScale;      // e.g. 1024
float  _SmoothingRadiusWS_LiquidSmall; // world units, splat kernel size for LIQUID SURFACE/lonely particles (low SPH density). 0 = single-voxel dot.
float  _SmoothingRadiusWS_LiquidBulk;  // world units, splat kernel size for LIQUID BULK particles (high SPH density)
float  _SmoothingRadiusWS_Vapour;      // world units, splat kernel size for VAPOUR particles (uniform — vapour grid is a low-frequency presence mask)
float  _AdaptiveDensitySurface; // SPH density value treated as "surface/lonely" → uses _SmoothingRadiusWS_LiquidSmall
float  _AdaptiveDensityBulk;    // SPH density value treated as "fully bulk"     → uses _SmoothingRadiusWS_LiquidBulk
float  _AdaptiveDensityCurve;   // gamma applied to t before lerp. 1 = linear, <1 exaggerates low-density variation, >1 exaggerates high-density variation
int    _KernelRadiusVoxels;   // loop bound covering the LARGER of the two radii (bulk). Falloff zeroes smaller-h splats automatically.
float2 _InvDensityScaleRG;    // x = liquid scale, y = vapour scale (vapour rest density is lower)

// ── Splash rejection (debug/test) ───────────────────────────────────────────
// LIQUID-ONLY (phase 0). A particle is fully skipped (contributes nothing to the
// density grid) if either condition is met:
//   p.density < _SplashRejectDensityBelow      (isolated / low-neighbor → likely splash)
//   length(p.velocity) > _SplashRejectSpeedAbove (fast → likely splash)
// Each test is disabled when its threshold is <= 0, so set both to 0 to keep
// the previous behaviour. Vapour particles are always unaffected.
float  _SplashRejectDensityBelow;
float  _SplashRejectSpeedAbove;
// ─────────────────────────────────────────────────────────────────────────────

// ── Gaussian blur params (vapour) ───────────────────────────────────────────
int    _BlurRadius;              // neighborhood half-size in voxels (1 = 3^3, 2 = 5^3, etc.)
float  _BlurSigma;               // Gaussian sigma in voxels; controls falloff rate
float  _BlurDetailPreserve;      // 0 = pure smooth, 1 = original detail fully added back (sharpening)
// ─────────────────────────────────────────────────────────────────────────────

// ── Gaussian blur params (liquid) ────────────────────────────────────────────
int    _LiquidBlurRadius;        // neighborhood half-size in voxels
float  _LiquidBlurSigma;         // Gaussian sigma in voxels
float  _LiquidBlurDetailPreserve;// 0 = pure smooth, 1 = original detail fully added back
// ─────────────────────────────────────────────────────────────────────────────

uint GridIndex(int3 v)
{
    return (uint)(v.x + _VolumeDims.x * (v.y + _VolumeDims.y * v.z));
}

[numthreads(8, 8, 8)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_VolumeDims.x || id.y >= (uint)_VolumeDims.y || id.z >= (uint)_VolumeDims.z)
        return;

    uint N   = (uint)(_VolumeDims.x * _VolumeDims.y * _VolumeDims.z);
    uint idx = (uint)(id.x + (uint)_VolumeDims.x * (id.y + (uint)_VolumeDims.y * id.z));
    _DensityGrid[idx]     = 0;  // liquid slab
    _DensityGrid[N + idx] = 0;  // vapour slab
}

// slabOffset: 0 for liquid slab, N for vapour slab.
void AtomicAddDensity(int3 v, uint slabOffset, uint amount)
{
    if (any(v < 0) || v.x >= _VolumeDims.x || v.y >= _VolumeDims.y || v.z >= _VolumeDims.z)
        return;

    uint idx = slabOffset + GridIndex(v);
    uint original;
    InterlockedAdd(_DensityGrid[idx], amount, original);
}

[numthreads(256, 1, 1)]
void SplatParticles(uint id : SV_DispatchThreadID)
{
    if (id >= _ParticleCount)
        return;

    Particle p = _ParticleBuffer[id];

    // Route to slab by phase.
    //   phase == 0  →  liquid slab  (offset 0)
    //   phase == 1  →  vapour slab  (offset N)
    //   anything else (e.g. -1 = boundary/inactive)  →  skip
    if (p.phase < 0 || p.phase > 1)
        return;



    uint N          = (uint)(_VolumeDims.x * _VolumeDims.y * _VolumeDims.z);
    uint slabOffset = (p.phase == 1) ? N : 0u;

    float3 minWS  = _BoundsMinWS.xyz;
    float3 maxWS  = _BoundsMaxWS.xyz;
    float3 sizeWS = maxWS - minWS;

    // Map particle position to normalized [0..1] volume coordinates.
    float3 uvw = (p.position - minWS) / max(sizeWS, 1e-5);
    if (uvw.x < 0.0 || uvw.y < 0.0 || uvw.z < 0.0 || uvw.x > 1.0 || uvw.y > 1.0 || uvw.z > 1.0)
        return;

    float3 gridPos = uvw * (float3)(_VolumeDims - 1);
    int3   base    = (int3)floor(gridPos);

    // Use the SPH-computed density directly: bulk regions have high p.density naturally,
    // isolated particles have low p.density. _ParticleContribution is now just a display scale.
    float baseAmount = max(0.0, p.density * _ParticleContribution) * max(_FixedPointScale, 1.0);

    // Fast path: when the loop bound is zero, every particle reduces to a 1-voxel splat.
    if (_KernelRadiusVoxels <= 0)
    {
        uint amt = (uint)round(baseAmount);
        AtomicAddDensity(base, slabOffset, amt);
        return;
    }

    // ── Adaptive per-particle smoothing radius ─────────────────────────────────
    // Only meaningful for LIQUID (phase 0). Vapour particles have a much lower rest
    // density and a different role here — the physics grid is just a low-frequency
    // "where is there vapour?" mask consumed by the per-fragment FBM in the
    // raymarcher. Forcing the bulk/surface heuristic on vapour produces patchy,
    // density-dependent splat sizes that the noise then amplifies into artifacts.
    // For vapour we use a dedicated _SmoothingRadiusWS_Vapour so the slab is a
    // smooth, uniform presence mask, independent of the liquid radii.
    float h;
    if (p.phase == 1)
    {
        h = _SmoothingRadiusWS_Vapour;
    }
    else
    {
        // Map SPH density [_AdaptiveDensitySurface .. _AdaptiveDensityBulk] → [0..1],
        // then bend the response with a gamma curve so small density differences in
        // one end of the range still produce visibly different splat radii:
        //   _AdaptiveDensityCurve = 1   → linear lerp
        //   _AdaptiveDensityCurve < 1   → expand the LOW-density end (more variation between
        //                                 splash / lonely particles whose densities cluster
        //                                 tightly just above the rest density)
        //   _AdaptiveDensityCurve > 1   → expand the HIGH-density end
        //   t = 0  → fully surface / lonely → use _SmoothingRadiusWS_LiquidSmall (small or 0)
        //   t = 1  → fully bulk             → use _SmoothingRadiusWS_LiquidBulk (large)
        float densitySpan = max(_AdaptiveDensityBulk - _AdaptiveDensitySurface, 1e-5);
        float tLin  = saturate((p.density - _AdaptiveDensitySurface) / densitySpan);
        float tCurv = pow(tLin, max(_AdaptiveDensityCurve, 1e-3));

        h = lerp(_SmoothingRadiusWS_LiquidSmall, _SmoothingRadiusWS_LiquidBulk, tCurv);
    }

    // Per-particle nearest-voxel fast path: if THIS particle's radius is ~zero,
    // splat it as a single voxel so very low-density particles render as crisp dots
    // (without disabling splatting for the rest of the simulation).
    if (h < 0)
    {
        uint amt = (uint)round(baseAmount);
        AtomicAddDensity(base, slabOffset, amt);
        return;
    }

    float invH2 = 1.0 / max(h * h, 1e-6);

    // Splat into a small voxel neighborhood using a cheap poly6-ish falloff:
    // w = (1 - (r/h)^2)^3 for r<=h.
    // _KernelRadiusVoxels is sized for the BULK (largest) h; smaller per-particle
    // h naturally produces w == 0 outside its own footprint, so we don't need
    // per-particle loop bounds.
    int r = _KernelRadiusVoxels;

    [loop]
    for (int dz = -r; dz <= r; dz++)
    {
        [loop]
        for (int dy = -r; dy <= r; dy++)
        {
            [loop]
            for (int dx = -r; dx <= r; dx++)
            {
                int3 v = base + int3(dx, dy, dz);
                if (any(v < 0) || v.x >= _VolumeDims.x || v.y >= _VolumeDims.y || v.z >= _VolumeDims.z)
                    continue;

                // World-space centre of voxel.
                float3 voxelCenterUVW = ((float3)v + 0.5) / (float3)_VolumeDims;
                float3 voxelCenterWS  = minWS + voxelCenterUVW * sizeWS;

                float3 d     = voxelCenterWS - p.position;
                float  dist2 = dot(d, d);

                float t = saturate(1.0 - dist2 * invH2);
                float w = t * t * t;

                uint amt = (uint)round(baseAmount * w);
                if (amt == 0)
                    continue;

                AtomicAddDensity(v, slabOffset, amt);
            }
        }
    }
}

[numthreads(8, 8, 8)]
void NormalizeToTexture(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_VolumeDims.x || id.y >= (uint)_VolumeDims.y || id.z >= (uint)_VolumeDims.z)
        return;

    uint N   = (uint)(_VolumeDims.x * _VolumeDims.y * _VolumeDims.z);
    uint idx = GridIndex((int3)id);

    float invScale      = max(_FixedPointScale, 1.0);
    float liquidNorm    = ((float)_DensityGrid[idx]     / invScale) * _InvDensityScaleRG.x;
    float vapourNorm    = ((float)_DensityGrid[N + idx] / invScale) * _InvDensityScaleRG.y;

    _DensityTexture3D_RG[id] = float2(saturate(liquidNorm), saturate(vapourNorm));
}

// ── BlurLiquidDensity kernel ─────────────────────────────────────────────────────
// Runs AFTER NormalizeToTexture. Reads from _DensityTexture3D_Read and writes a
// Gaussian-blurred liquid channel to _DensityTexture3D_RG.
// Vapour (G channel) is copied unchanged — blur only applies to liquid (R).
// ────────────────────────────────────────────────────────────────────────────────
[numthreads(8, 8, 8)]
void BlurLiquidDensity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_VolumeDims.x || id.y >= (uint)_VolumeDims.y || id.z >= (uint)_VolumeDims.z)
        return;

    int3  dims     = _VolumeDims;
    float original = _DensityTexture3D_Read[(int3)id].r;

    float liquidSum  = 0.0;
    float weightSum  = 0.0;
    float invTwoSig2 = 1.0 / max(2.0 * _LiquidBlurSigma * _LiquidBlurSigma, 1e-6);
    int   r          = clamp(_LiquidBlurRadius, 1, 4);

    [loop]
    for (int dz = -r; dz <= r; dz++)
    {
    [loop]
    for (int dy = -r; dy <= r; dy++)
    {
    [loop]
    for (int dx = -r; dx <= r; dx++)
    {
        float dist2 = (float)(dx*dx + dy*dy + dz*dz);
        float w     = exp(-dist2 * invTwoSig2);
        int3  coord = clamp((int3)id + int3(dx, dy, dz), int3(0, 0, 0), dims - 1);
        liquidSum  += w * _DensityTexture3D_Read[coord].r;
        weightSum  += w;
    }
    }
    }

    float blurred     = liquidSum / max(weightSum, 1e-6);
    float finalLiquid = blurred + _LiquidBlurDetailPreserve * (original - blurred);

    float vapour = _DensityTexture3D_Read[(int3)id].g;  // vapour stays exact
    _DensityTexture3D_RG[id] = float2(saturate(finalLiquid), vapour);
}

// ── BlurVapourDensity kernel ──────────────────────────────────────────────────────
// Runs AFTER NormalizeToTexture. Reads from _DensityTexture3D_Read and writes a
// Gaussian-blurred vapour channel to _DensityTexture3D_RG.
// Liquid (R channel) is copied unchanged — blur only applies to vapour (G).
//
// Blur parameters (set from C# each frame):
//   _BlurRadius        - half-size of the kernel in voxels (1→3^3, 2→5^3, 3→7^3)
//   _BlurSigma         - Gaussian sigma in voxels; small = sharp falloff, large = wide blur
//   _BlurDetailPreserve- [0,1] mix: 0 = pure blurred, 1 = full original detail added back
//
// Detail preservation: finalVapour = blurred + detailPreserve * (original - blurred)
// At 0 this gives a completely smooth field (best for noisy sparse splats).
// At 1 the original high-frequency structure is fully restored on top of the smooth base.
// ────────────────────────────────────────────────────────────────────────────────
[numthreads(8, 8, 8)]
void BlurVapourDensity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_VolumeDims.x || id.y >= (uint)_VolumeDims.y || id.z >= (uint)_VolumeDims.z)
        return;

    int3  dims     = _VolumeDims;
    float original = _DensityTexture3D_Read[(int3)id].g;

    float vapourSum  = 0.0;
    float weightSum  = 0.0;
    float invTwoSig2 = 1.0 / max(2.0 * _BlurSigma * _BlurSigma, 1e-6);
    int   r          = clamp(_BlurRadius, 1, 4);

    [loop]
    for (int dz = -r; dz <= r; dz++)
    {
    [loop]
    for (int dy = -r; dy <= r; dy++)
    {
    [loop]
    for (int dx = -r; dx <= r; dx++)
    {
        float dist2 = (float)(dx*dx + dy*dy + dz*dz);
        float w     = exp(-dist2 * invTwoSig2);
        int3  coord = clamp((int3)id + int3(dx, dy, dz), int3(0, 0, 0), dims - 1);
        vapourSum  += w * _DensityTexture3D_Read[coord].g;
        weightSum  += w;
    }
    }
    }

    float blurred     = vapourSum / max(weightSum, 1e-6);
    // Detail preservation: add back the high-frequency residual from the original.
    float finalVapour = blurred + _BlurDetailPreserve * (original - blurred);

    float liquid = _DensityTexture3D_Read[(int3)id].r;  // liquid stays exact
    _DensityTexture3D_RG[id] = float2(liquid, saturate(finalVapour));
}

// ── BakeNormals kernel ────────────────────────────────────────────────────────
// Runs AFTER NormalizeToTexture (and blur/enhance if active).
// Reads the final liquid channel (R) from _DensityTexture3D_Read and writes a
// pre-baked outward surface normal into _NormalTexture3D (xyz = normal, w = 0).
// Both MarchingCubesCompute and WaterRaymarching sample this instead of computing
// per-vertex / per-fragment gradients at runtime.
//
// 4-voxel half-span matches the raymarcher's eps = 4/gridSize for consistent
// smoothness across both renderers on a 128^3 volume.
// ─────────────────────────────────────────────────────────────────────────────
[numthreads(8, 8, 8)]
void BakeNormals(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_VolumeDims.x || id.y >= (uint)_VolumeDims.y || id.z >= (uint)_VolumeDims.z)
        return;

    int3 c    = (int3)id;
    int3 dims = _VolumeDims;

    // Returns density at p, or 0.0 if p is outside the volume.
    // Outside the volume is air — this makes boundary voxels produce a valid
    // outward gradient even when the liquid is pressed against the volume edge.
    #define SAMPLE_OR_AIR(p) (any((p) < int3(0,0,0)) || any((p) >= dims) ? 0.0 : _DensityTexture3D_Read[(p)].r)

    // Central-difference gradient of the liquid density field (R channel).
    // Uses out-of-bounds=0 (air) instead of clamping so that liquid touching the
    // volume boundary still gets a correct outward normal on all six faces.
    float dx = SAMPLE_OR_AIR(c + int3(1,0,0)) - SAMPLE_OR_AIR(c - int3(1,0,0));
    float dy = SAMPLE_OR_AIR(c + int3(0,1,0)) - SAMPLE_OR_AIR(c - int3(0,1,0));
    float dz = SAMPLE_OR_AIR(c + int3(0,0,1)) - SAMPLE_OR_AIR(c - int3(0,0,1));

    float3 grad = float3(dx, dy, dz);
    float  len  = length(grad);
    // Negate: positive-density gradient points into the liquid;
    // outward surface normal points away from the liquid.
    float3 n = (len >= 1e-4) ? -(grad / len) : float3(0.0, 0.0, 0.0);

    _NormalTexture3D[id] = float4(n, 0.0);
}
